# SoloHeaven configuration
# Copy to .env and edit for your setup.
# All settings can also be passed as CLI arguments (run `soloheaven --help`).

# ============================================================
# Upstream backend
# ============================================================

# OpenAI-compatible server, for example vLLM:
#   vllm serve Qwen/Qwen3.5-0.8B --port 8001
SOLOHEAVEN_OPENAI_BASE_URL=http://127.0.0.1:8001/v1
SOLOHEAVEN_OPENAI_API_KEY=EMPTY

# Single model (use one of MODEL or MODELS)
SOLOHEAVEN_MODEL=Qwen/Qwen3.5-0.8B

# Multiple models: comma-separated, optional alias= prefix, optional :no_think_tag suffix
# SOLOHEAVEN_MODELS=qwen35=Qwen/Qwen3.5-0.8B,qwen35-fast=Qwen/Qwen3.5-0.8B:no_think_tag

# ============================================================
# Server
# ============================================================

SOLOHEAVEN_HOST=0.0.0.0
SOLOHEAVEN_PORT=8000
SOLOHEAVEN_DATA_DIR=./data

# ============================================================
# Default generation settings
# ============================================================

SOLOHEAVEN_TEMPERATURE=0.6
SOLOHEAVEN_TOP_P=1.0
SOLOHEAVEN_MIN_P=0.0
SOLOHEAVEN_TOP_K=0
SOLOHEAVEN_REPETITION_PENALTY=1.0
SOLOHEAVEN_MAX_TOKENS=32768
SOLOHEAVEN_THINKING_BUDGET=8192

# ============================================================
# Flags
# ============================================================

SOLOHEAVEN_VERBOSE=false
